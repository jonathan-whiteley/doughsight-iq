# Databricks sync ignore file
# This controls what gets synced to Databricks workspace
# Note: databricks sync respects .gitignore by default, but we override some entries here

# === MUST EXCLUDE ===
# Node modules - very large, not needed (npm install runs locally only)
node_modules/
frontend/node_modules/

# Node manifests - exclude so the Apps platform does NOT auto-detect a Node
# build (this is a Python app serving the prebuilt frontend/dist). Auto-Node
# detection can time out the build.
package.json
package-lock.json
frontend/package.json
frontend/package-lock.json
frontend/tsconfig.json
frontend/tsconfig.node.json
frontend/vite.config.ts
frontend/postcss.config.js
frontend/tailwind.config.js

# Python virtual environments
env/
venv/
.venv/
__pycache__/
*.pyc

# Git
.git/

# IDE/Editor
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Test/Coverage
.pytest_cache/
htmlcov/
.coverage

# Build artifacts we don't need
*.egg-info/
build/

# Reference folder (example code, not needed for deployment)
reference/

# Notebooks folder (run separately in Databricks, not part of app)
notebooks/

# Documentation
docs/
*.md
!README.md

# Development files
.env
.envrc
env.example

